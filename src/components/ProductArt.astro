---
/**
 * Arte provisória de produto: silhueta geométrica "fatiada" em camadas
 * (conceito do fatiador 3D). Base em laranja = primeira camada.
 * Substituir por fotos reais dos produtos quando existirem.
 */
interface Props {
  kind: 'estatua' | 'capacete' | 'cubo' | 'engrenagem' | 'busto' | 'automato' | 'impressora' | 'filamento' | 'resina';
  uid: string;
}
const { kind, uid } = Astro.props;
const H = 250, PITCH = 9, GAP = 3;
const slices = Array.from({ length: Math.ceil(H / PITCH) }, (_, i) => i * PITCH + (PITCH - GAP));
const teeth = Array.from({ length: 10 }, (_, i) => i * 36);
---
<svg class="art" viewBox="0 0 200 250" role="img" aria-hidden="true" preserveAspectRatio="xMidYMid meet">
  <defs>
    <linearGradient id={`${uid}-g`} gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2={H}>
      <stop offset="0" stop-color="#f2ebdd" />
      <stop offset="0.884" stop-color="#f2ebdd" />
      <stop offset="0.884" stop-color="#e8641a" />
      <stop offset="1" stop-color="#e8641a" />
    </linearGradient>
    <mask id={`${uid}-m`} maskUnits="userSpaceOnUse" x="0" y="0" width="200" height={H}>
      <rect width="200" height={H} fill="#fff" />
      {slices.map((y) => <rect x="0" y={y} width="200" height={GAP} fill="#000" />)}
      {kind === 'capacete' && (<>
        <rect x="58" y="106" width="84" height="32" rx="14" fill="#000" />
        <rect x="90" y="152" width="20" height="4" fill="#000" /><rect x="90" y="164" width="20" height="4" fill="#000" /><rect x="90" y="176" width="20" height="4" fill="#000" />
      </>)}
      {kind === 'engrenagem' && <circle cx="100" cy="128" r="20" fill="#000" />}
      {kind === 'automato' && (<>
        <circle cx="82" cy="90" r="9" fill="#000" /><circle cx="118" cy="90" r="9" fill="#000" />
        <rect x="84" y="142" width="32" height="24" rx="3" fill="#000" />
      </>)}
      {kind === 'resina' && <rect x="76" y="138" width="48" height="52" rx="4" fill="#000" />}
    </mask>
  </defs>

  <g fill={`url(#${uid}-g)`} mask={`url(#${uid}-m)`}>
    {kind === 'estatua' && (<>
      <rect x="46" y="222" width="108" height="16" rx="2" />
      <rect x="58" y="208" width="84" height="14" />
      <path d="M78 210 L84 146 L116 146 L122 210 Z" />
      <path d="M60 98 L74 82 L126 82 L140 98 L132 150 L68 150 Z" />
      <path d="M50 102 L62 100 L60 160 L48 160 Z" />
      <path d="M150 102 L138 100 L140 160 L152 160 Z" />
      <circle cx="100" cy="60" r="18" />
      <rect x="92" y="74" width="16" height="10" />
      <rect x="160" y="26" width="4" height="196" />
      <path d="M162 18 L170 38 L154 38 Z" />
    </>)}
    {kind === 'capacete' && (<>
      <path d="M38 150 C38 86 66 48 100 48 C134 48 162 86 162 150 L162 190 L136 214 L64 214 L38 190 Z" />
      <path d="M95 30 L105 30 L110 50 L90 50 Z" />
      <rect x="52" y="222" width="96" height="16" rx="2" />
    </>)}
    {kind === 'cubo' && (<>
      <path d="M100 48 L166 86 L100 124 L34 86 Z" />
      <path d="M34 98 L96 134 L96 212 L34 176 Z" />
      <path d="M166 98 L104 134 L104 212 L166 176 Z" />
      <rect x="52" y="224" width="96" height="14" rx="2" />
    </>)}
    {kind === 'engrenagem' && (<>
      <circle cx="100" cy="128" r="54" />
      {teeth.map((a) => <rect x="88" y="52" width="24" height="26" transform={`rotate(${a} 100 128)`} />)}
      <rect x="62" y="220" width="76" height="18" rx="2" />
      <rect x="88" y="196" width="24" height="24" />
    </>)}
    {kind === 'busto' && (<>
      <ellipse cx="100" cy="86" rx="34" ry="42" />
      <rect x="86" y="122" width="28" height="28" />
      <path d="M32 196 C36 164 68 150 100 150 C132 150 164 164 168 196 L168 212 L32 212 Z" />
      <rect x="46" y="220" width="108" height="18" rx="2" />
    </>)}
    {kind === 'automato' && (<>
      <rect x="62" y="62" width="76" height="56" rx="10" />
      <rect x="97" y="34" width="6" height="28" />
      <circle cx="100" cy="30" r="7" />
      <rect x="56" y="124" width="88" height="70" rx="8" />
      <rect x="34" y="128" width="16" height="56" rx="4" />
      <rect x="150" y="128" width="16" height="56" rx="4" />
      <rect x="68" y="198" width="26" height="24" />
      <rect x="106" y="198" width="26" height="24" />
      <rect x="54" y="222" width="92" height="16" rx="2" />
    </>)}
    {kind === 'impressora' && (<>
      <rect x="30" y="222" width="140" height="16" rx="2" />
      <rect x="38" y="200" width="124" height="22" />
      <rect x="42" y="50" width="14" height="150" />
      <rect x="144" y="50" width="14" height="150" />
      <rect x="42" y="40" width="116" height="14" />
      <rect x="52" y="96" width="96" height="9" />
      <rect x="86" y="88" width="28" height="30" rx="3" />
      <path d="M96 118 H104 L100 130 Z" />
      <path d="M68 198 H132 L124 150 H76 Z" />
    </>)}
    {kind === 'filamento' && (<>
      <path fill-rule="evenodd" d="M28 124 a72 72 0 1 0 144 0 a72 72 0 1 0 -144 0 Z M40 124 a60 60 0 1 0 120 0 a60 60 0 1 0 -120 0 Z" />
      <path fill-rule="evenodd" d="M46 124 a54 54 0 1 0 108 0 a54 54 0 1 0 -108 0 Z M80 124 a20 20 0 1 0 40 0 a20 20 0 1 0 -40 0 Z" />
      <rect x="56" y="204" width="88" height="18" />
      <rect x="46" y="222" width="108" height="16" rx="2" />
    </>)}
    {kind === 'resina' && (<>
      <rect x="62" y="98" width="76" height="124" rx="12" />
      <rect x="86" y="72" width="28" height="30" />
      <rect x="80" y="48" width="40" height="26" rx="3" />
      <rect x="50" y="222" width="100" height="16" rx="2" />
    </>)}
  </g>
</svg>

<style>
  .art { width: 100%; height: 100%; }
</style>

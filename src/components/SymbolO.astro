---
/**
 * Símbolo "O" da Axis Zero: 12 faixas iguais, 2:3, vazado interno 42,5% × 50%.
 * As 2 últimas faixas são laranja (a "primeira camada").
 *
 * animate: monta as faixas (de baixo para cima) quando a página fica pronta.
 * play:    monta as faixas imediatamente (usado no loader).
 */
interface Props {
  uid?: string;
  animate?: boolean;
  play?: boolean;
  class?: string;
}
const { uid = 'o', animate = false, play = false, class: className } = Astro.props;
const W = 200, H = 300, N = 12, RATIO = 0.5;
const h = H / (N + (N - 1) * RATIO);
const gap = h * RATIO;
const stripes = Array.from({ length: N }, (_, i) => ({ y: i * (h + gap), orange: i >= N - 2, i }));
---
<svg class:list={['symbol-o', { 'is-animated': animate, 'is-playing': play }, className]} viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Símbolo Axis Zero">
  <defs>
    <!-- Contorno externo + vazado interno num único clipPath (evenodd): mais robusto
         que máscara quando as faixas estão animando. -->
    <clipPath id={`${uid}-clip`}>
      <path
        clip-rule="evenodd"
        d="M76 0H124A76 76 0 0 1 200 76V224A76 76 0 0 1 124 300H76A76 76 0 0 1 0 224V76A76 76 0 0 1 76 0Z
           M83.5 75H116.5A26 26 0 0 1 142.5 101V199A26 26 0 0 1 116.5 225H83.5A26 26 0 0 1 57.5 199V101A26 26 0 0 1 83.5 75Z"
      />
    </clipPath>
  </defs>
  <g clip-path={`url(#${uid}-clip)`}>
    {stripes.map((s) => (
      <rect class="stripe" style={`--i:${N - 1 - s.i}`} y={s.y} width={W} height={h} fill={s.orange ? 'var(--orange)' : 'var(--ivory)'} />
    ))}
  </g>
</svg>

<style is:global>
  .symbol-o { width: 100%; height: auto; overflow: visible; }
  .symbol-o .stripe { transform-box: fill-box; transform-origin: center; }

  /* estado inicial (só com JS): faixas recolhidas */
  .js .symbol-o.is-animated .stripe { transform: scaleX(0); opacity: 0; }
  .js .symbol-o.is-playing .stripe { transform: scaleX(0); opacity: 0; animation: layer-in .7s cubic-bezier(.2,.8,.2,1) both; animation-delay: calc(var(--i) * 85ms + 80ms); }
  .js.is-ready .symbol-o.is-animated .stripe {
    animation: layer-in .7s cubic-bezier(.2,.8,.2,1) both;
    animation-delay: calc(var(--i) * 70ms + 200ms);
  }
  @keyframes layer-in {
    from { transform: scaleX(0); opacity: 0; }
    to   { transform: scaleX(1); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .js .symbol-o .stripe { transform: none !important; opacity: 1 !important; }
  }
</style>

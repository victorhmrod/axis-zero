---
const steps = [
  { n: '01', title: 'Modelagem', text: 'Escultura digital e fatiamento: cada peça é pensada camada por camada.' },
  { n: '02', title: 'Impressão', text: 'Resina 8K ou 16K, ou filamento em peças grandes. Horas de cura, sem atalhos.' },
  { n: '03', title: 'Lixa e primer', text: 'Suportes removidos, lixa progressiva e primer até a superfície ficar lisa.' },
  { n: '04', title: 'Pintura à mão', text: 'Pincel e aerógrafo. Cada peça sai assinada e numerada.' },
];
const values = ['Precisão', 'Processo visível', 'Acabamento', 'Criatividade', 'Honestidade de material'];
---
<section class="section process" id="processo" aria-labelledby="proc-title">
  <div class="container">
    <p class="eyebrow" data-reveal><span class="num">05</span> Processo</p>

    <div class="process__head">
      <h2 id="proc-title" class="display" data-reveal="clip">Camada <em>por camada</em></h2>
      <p data-reveal style="--d:2">
        Falamos como quem domina o processo e tem orgulho do acabamento.
        Mostramos o trabalho: camadas, lixa, tinta, pincel.
      </p>
    </div>

    <ol class="process__grid">
      {steps.map((s, idx) => (
        <li class="step chamfer chamfer--hover" style={`--c: 18px; --d:${idx};`} data-reveal>
          <div class="step__top">
            <span class="step__n display">{s.n}</span>
            <span class="step__layers" aria-hidden="true">
              {Array.from({ length: 4 }, (_, i) => (
                <i class:list={[{ on: i >= 3 - idx, o: i === 3 }]} style={`width:${60 + i * 12}%; --n:${i}`}></i>
              ))}
            </span>
          </div>
          <h3 class="display">{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>

  <div class="values" aria-label="Valores">
    <ul class="values__track" data-marquee="left" data-speed="42" data-pause>
      {[...values, ...values].map((v) => (
        <li class="display"><span>{v}</span><i aria-hidden="true"></i></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .process { padding-bottom: 0; }
  .process__head {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 32px 64px;
    align-items: end;
    margin: 28px 0 clamp(32px, 5vw, 56px);
  }
  .process__head h2 { font-size: clamp(44px, 7vw, 96px); }
  .process__head p { color: var(--steel); max-width: 44ch; }

  .process__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; counter-reset: s; }
  .step { display: grid; align-content: start; gap: 12px; padding: 26px; min-height: 280px; }
  .step__top { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 36px; }
  .step__n { font-size: 20px; color: var(--orange); }
  .step__layers { display: grid; gap: 4px; justify-items: end; flex: 1; }
  .step__layers i { display: block; height: 4px; background: var(--line-strong); }
  .step__layers i.on { background: var(--ivory); }
  .step__layers i.o { background: var(--orange); }
  /* as faixas crescem quando o card aparece */
  .step__layers i { transform-origin: right; transition: transform .8s cubic-bezier(.2,.8,.2,1) calc(var(--d, 0) * 90ms + 350ms + var(--n, 0) * 90ms); }
  :global(.js) .step:not(.in) .step__layers i { transform: scaleX(0); }  .step h3 { font-size: 32px; }
  .step p { color: var(--steel); font-size: 14.5px; }

  .values {
    margin-top: clamp(64px, 9vw, 120px);
    border-block: 1px solid var(--line);
    overflow: hidden;
    padding-block: 22px;
  }
  .values__track {
    display: flex;
    width: max-content;
    gap: 0;
  }
  .values__track li { display: flex; align-items: center; font-size: clamp(28px, 3.4vw, 44px); white-space: nowrap; }
  .values__track i { display: block; width: 12px; height: 12px; background: var(--orange); margin-inline: clamp(24px, 3vw, 44px); }

  @media (max-width: 1040px) { .process__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) { .process__head { grid-template-columns: 1fr; } }
  @media (max-width: 560px) {
    .process__grid { grid-template-columns: 1fr; }
    .step { min-height: 0; }
    .step__top { margin-bottom: 20px; }
  }
</style>

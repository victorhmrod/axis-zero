---
/* Duas fitas cruzadas, em sentidos opostos; aceleram com a rolagem. */
const a = ['Camada por camada', 'Do zero à forma', 'Pintado à mão', 'Edições numeradas', 'Resina 8K'];
const b = ['Tudo começa na primeira camada', 'Peças exclusivas', 'Precisão', 'Acabamento', 'Processo visível'];
const group = (items: string[]) => [...items, ...items];
---
<div class="tapes" aria-hidden="true">
  <div class="tape tape--orange">
    <div class="tape__track" data-marquee="left" data-speed="38">
      {[0, 1].map(() => (
        <div class="tape__group">
          {group(a).map((t) => <span class="display">{t}<i></i></span>)}
        </div>
      ))}
    </div>
  </div>
  <div class="tape tape--ivory">
    <div class="tape__track" data-marquee="right" data-speed="46">
      {[0, 1].map(() => (
        <div class="tape__group">
          {group(b).map((t) => <span class="display">{t}<i></i></span>)}
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .tapes {
    position: relative;
    overflow: hidden;
    padding-block: clamp(36px, 5vw, 64px);
    isolation: isolate;
  }
  .tape {
    position: relative;
    width: 112%;
    margin-left: -6%;
    overflow: hidden;
    padding-block: 14px;
    white-space: nowrap;
  }
  .tape--orange { background: var(--orange); color: var(--ink); transform: rotate(-1.6deg); z-index: 2; }
  .tape--ivory { background: var(--ivory); color: var(--ink); transform: rotate(1.2deg); margin-top: -34px; z-index: 1; }

  .tape__track { display: flex; width: max-content; will-change: transform; }
  .tape__group { display: flex; flex: none; }
  .tape span {
    display: inline-flex;
    align-items: center;
    font-size: clamp(26px, 3.4vw, 44px);
    line-height: 1;
  }
  .tape i {
    flex: none;
    width: 12px; height: 12px;
    margin-inline: clamp(22px, 2.6vw, 40px);
    background: var(--ink);
  }
  .tape--ivory i { background: var(--orange); }
</style>

---
import { url } from '../utils/url';
import SymbolO from './SymbolO.astro';

const specs = [
  { k: 'Material', v: 'Resina 8K' },
  { k: 'Acabamento', v: 'Pintura à mão' },
  { k: 'Edições', v: 'Numeradas' },
  { k: 'Envio', v: 'Segurado' },
];
---
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow eyebrow--plain" data-reveal><span class="num">00</span> Colecionáveis exclusivos</p>

      <h1 class="display hero__title">
        <span class="ln"><span style="--d:0">Tudo começa</span></span>
        <span class="ln"><span style="--d:1">na <em>primeira</em></span></span>
        <span class="ln"><span style="--d:2">camada.</span></span>
      </h1>

      <p class="hero__lead" data-reveal style="--d:3">
        Estátuas, colecionáveis, gadgets e peças de cosplay construídos camada por camada.
        Impresso em resina, lixado e pintado à mão. Cada peça sai numerada.
      </p>

      <div class="hero__cta" data-reveal style="--d:4">
        <a class="btn" href={url('/colecao')}>
          Ver coleção
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><path d="M4 12h16M13 5l7 7-7 7" /></svg>
        </a>
        <a class="btn btn--ghost" href="#encomendas">Encomendas</a>
      </div>

      <dl class="hero__specs" data-reveal style="--d:5">
        {specs.map((s) => (
          <div>
            <dt class="label">{s.k}</dt>
            <dd>{s.v}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="hero__visual chamfer" style="--c: 28px; --bg: var(--surface);" data-tilt="4" data-reactive data-reveal="scale" data-cursor="Mova">
      <div class="grid-bg" aria-hidden="true"></div>
      <div class="glow" aria-hidden="true"></div>
      <span class="tick tick--tl label">X 000 · Y 000 · Z 000</span>
      <span class="tick tick--br label">Camada 012 / 012</span>
      <span class="axis axis--v" aria-hidden="true"></span>
      <span class="axis axis--h" aria-hidden="true"></span>
      <div class="hero__symbol">
        <SymbolO uid="hero" animate />
        <span class="scan" aria-hidden="true"></span>
      </div>
    </div>
  </div>

</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(40px, 6vw, 88px) 0;
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    padding-bottom: clamp(48px, 6vw, 88px);
  }
  .hero__copy { display: grid; gap: 28px; }
  .hero__title { font-size: clamp(56px, 9.2vw, 132px); }

  /* títulos sobem de dentro de uma máscara, linha por linha */
  .ln { display: block; overflow: hidden; padding: .14em 0 .1em; margin: -.14em 0 -.1em; }
  :global(.js) .ln > span { display: inline-block; transform: translateY(118%); }
  :global(.js.is-ready) .ln > span {
    transform: none;
    transition: transform 1.1s cubic-bezier(.2,.8,.2,1) calc(var(--d) * 130ms + 250ms);
  }
  .hero__title em { display: inline-block; }
  .hero__lead {
    max-width: 52ch;
    font-size: clamp(16px, 1.3vw, 18px);
    color: #cfc8ba;
  }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; }

  .hero__specs {
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: start;
    gap: 0;
    margin: 12px 0 0;
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }
  .hero__specs > div { padding-right: clamp(16px, 2.4vw, 36px); margin-right: clamp(16px, 2.4vw, 36px); border-right: 1px solid var(--line); }
  .hero__specs > div:last-child { border-right: 0; margin-right: 0; padding-right: 0; }
  .hero__specs dd { margin: 4px 0 0; font-weight: 600; font-size: 15px; }

  .hero__visual {
    min-height: 520px;
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
  }
  .grid-bg {
    position: absolute; inset: 0; z-index: -1;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: .35;
    mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
  }
  .hero__symbol {
    width: min(52%, 250px);
    position: relative;
    z-index: 1;
    transform: translate3d(calc(var(--px, 0) * 22px), calc(var(--py, 0) * 22px), 0);
    transition: transform .4s cubic-bezier(.2,.8,.2,1);
  }
  /* cabeçote de impressão: varre o símbolo de baixo para cima a cada 7 s */
  .scan {
    position: absolute;
    left: -22%; right: -22%;
    top: 100%;
    height: 2px;
    background: var(--orange);
    box-shadow: 0 0 22px 3px rgba(232, 100, 26, .7);
    opacity: 0;
    pointer-events: none;
  }
  :global(.js.is-ready) .scan { animation: scan 7s linear .2s infinite; }
  @keyframes scan {
    0%   { top: 100%; opacity: 0; }
    1%   { opacity: 1; }
    12%  { top: 0;    opacity: 1; }
    13%  { top: 0;    opacity: 0; }
    100% { top: 0;    opacity: 0; }
  }
  /* luz laranja que segue o cursor */
  .glow {
    position: absolute; inset: 0; z-index: -1;
    background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 50%), rgba(232, 100, 26, .22), transparent 65%);
    opacity: 0;
    transition: opacity .4s;
  }
  .hero__visual:hover .glow { opacity: 1; }
  :global(.hero__visual .stripe) { transition: scale .35s cubic-bezier(.2,.8,.2,1), fill .35s; }
  .axis { position: absolute; background: var(--orange); opacity: .5; }
  .axis--v { left: 50%; top: 28px; bottom: 28px; width: 1px; background: repeating-linear-gradient(var(--orange) 0 6px, transparent 6px 12px); }
  .axis--h { top: 50%; left: 28px; right: 28px; height: 1px; background: repeating-linear-gradient(90deg, var(--orange) 0 6px, transparent 6px 12px); }
  .tick { position: absolute; z-index: 2; }
  .tick--tl { top: 22px; left: 42px; }
  .tick--br { bottom: 20px; right: 42px; color: var(--orange); }

  @media (max-width: 960px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__visual { aspect-ratio: auto; min-height: 420px; max-width: 520px; width: 100%; margin-inline: auto; }
    .hero__specs { grid-template-columns: repeat(2, auto); row-gap: 18px; }
    .hero__specs > div:nth-child(2) { border-right: 0; margin-right: 0; padding-right: 0; }
  }
  @media (max-width: 520px) {
    .hero__visual { min-height: 340px; }
    .hero__cta .btn { flex: 1 1 100%; }
  }
</style>

---
import { url } from '../utils/url';
import CategoryIcon from './CategoryIcon.astro';

const cats = [
  { id: 'estatuas', label: 'Estátuas', desc: 'Peças de exposição de 20 a 60 cm.', count: 14 },
  { id: 'colecionaveis', label: 'Colecionáveis', desc: 'Edições numeradas, base assinada.', count: 28 },
  { id: 'gadgets', label: 'Gadgets', desc: 'Utilidades de mesa com acabamento de ateliê.', count: 21 },
  { id: 'cosplay', label: 'Cosplay', desc: 'Capacetes, armaduras e props vestíveis.', count: 9 },
] as const;
---
<section class="section cats" id="categorias" aria-labelledby="cats-title">
  <div class="container">
    <p class="eyebrow" data-reveal><span class="num">01</span> Categorias</p>
    <div class="section-head" style="margin-top: 28px;">
      <h2 id="cats-title" class="display" data-reveal="clip">Do zero <em>à forma</em></h2>
    </div>

    <ul class="cats__grid">
      {cats.map((c, i) => (
        <li data-reveal style={`--d:${i}`}>
          <a href={url(`/colecao?categoria=${c.id}`)} class="cat chamfer chamfer--hover" style="--c: 20px;">
            <span class="cat__icon"><CategoryIcon name={c.id} size={64} /></span>
            <span class="cat__body">
              <span class="cat__name display">{c.label}</span>
              <span class="cat__desc">{c.desc}</span>
            </span>
            <span class="cat__foot">
              <span class="label"><span data-count={c.count}>{c.count}</span> peças</span>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square"><path d="M4 12h16M13 5l7 7-7 7" /></svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cats { padding-top: clamp(40px, 5vw, 72px); }
  .cats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .cat {
    display: flex;
    flex-direction: column;
    gap: 28px;
    height: 100%;
    min-height: 280px;
    padding: 28px;
  }
  .cat__icon { color: var(--ivory); transition: color .2s, transform .45s cubic-bezier(.2,.8,.2,1); transform-origin: 20% 80%; width: fit-content; }
  .cat:hover .cat__icon { color: var(--orange); transform: rotate(-8deg) scale(1.12); }
  .cat { transition: background-color .2s, transform .35s cubic-bezier(.2,.8,.2,1); }
  .cat:hover { transform: translateY(-6px); }
  .cat__body { display: grid; gap: 8px; }
  .cat__name { font-size: 34px; }
  .cat__desc { color: var(--steel); font-size: 14px; line-height: 1.5; }
  .cat__foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    color: var(--ivory);
  }
  .cat:hover .cat__foot svg { color: var(--orange); transform: translateX(3px); }
  .cat__foot svg { transition: transform .2s, color .2s; }

  @media (max-width: 1040px) { .cats__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) {
    .cats__grid { grid-template-columns: 1fr; }
    .cat { min-height: 0; padding: 22px; gap: 20px; }
  }
</style>

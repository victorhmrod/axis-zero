---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}
const props = Astro.props;
---
<Base {...props}>
  <Header slot="header" />
  <slot />
  <Footer slot="footer" />
</Base>
